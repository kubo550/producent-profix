# Employee panel (/panel). Copy to .env.local for local development.

# Postgres (Neon). On Vercel this is set automatically by the Neon integration.
DATABASE_URL=

# Shared password for employees, min. 10 chars. Changing it logs everyone out.
PANEL_PASSWORD=

# Random secret for signing sessions, min. 32 chars: openssl rand -base64 32
SESSION_SECRET=

# Optional, dev only: local Neon HTTP proxy, e.g. http://localhost:4444/sql
# NEON_LOCAL_FETCH_ENDPOINT=

# Site (optional)
# Google Analytics id; for now it only turns on the cookie banner (GA itself is not wired yet).
NEXT_PUBLIC_GA_ID=
# Contact form; falls back to the key in src/content/site.ts.
NEXT_PUBLIC_WEB3FORMS_KEY=
